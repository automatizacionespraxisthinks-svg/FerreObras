# Postgres (la misma base que usa n8n)
DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# Clave de sesión (cualquier texto largo aleatorio)
SESSION_SECRET=cambia-esto-por-un-texto-largo-aleatorio

# Una clave por línea de WhatsApp (usuarios de la app)
PASS_3232=clave3232
PASS_3333=clave3333
PASS_3434=clave3434
PASS_3535=clave3535

# Usuario administrador (acceso al panel de informes /admin).
# Si ADMIN_PASS está vacío, el acceso de administrador queda deshabilitado.
# Si la clave lleva "#" u otros caracteres especiales, escríbela entre comillas (en Dokploy un "#" sin comillas
# corta el valor como si fuera un comentario): ADMIN_PASS="Clave#2026"
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave

# Webhooks de n8n (Production URL de cada flujo)
N8N_WEBHOOK_CALENDAR=https://ferren8n.praxisia.org/webhook/vip-calendar
N8N_WEBHOOK_CIERRE=https://ferren8n.praxisia.org/webhook/vip-cierre

PORT=3000
