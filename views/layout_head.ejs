<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#FFE600">
<title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>FerreObras</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<% if (locals.mapa) { %><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin="anonymous"><% } %>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<a class="saltar" href="#contenido">Ir al contenido</a>
<% const rutaActual = locals.ruta || '';
   const activo = (h) => ((h === '/' ? (rutaActual === '/' || (rutaActual.startsWith('/obras/') && rutaActual !== '/obras/nueva')) : rutaActual.startsWith(h)) ? 'activo' : ''); %>
<header class="cabecera">
  <div class="cabecera-int">
    <a class="logo" href="<%= locals.esAdmin ? '/admin' : '/' %>" aria-label="FerreObras, inicio"><%- include('logo') %></a>
    <% if (locals.usuario) { %>
    <button class="menu-btn" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-principal"><span></span><span></span><span></span></button>
    <nav id="nav-principal" class="nav" aria-label="Principal">
      <a href="/" class="<%= activo('/') %>">Obras</a>
      <a href="/obras/nueva" class="<%= activo('/obras/nueva') %>">Nueva obra</a>
      <a href="/rutas" class="<%= activo('/rutas') %>">Rutas</a>
      <a href="/lineas" class="<%= activo('/lineas') %>">Líneas de producto</a>
      <% if (locals.esAdmin) { %><a href="/admin" class="nav-admin <%= activo('/admin') %>"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3 17h2V9H3v8zm4 0h2V3H7v14zm4 0h2v-6h-2v6zm4 0h2V6h-2v11z"/></svg>Administración</a><% } %>
      <div class="nav-sesion">
        <span class="usuario-chip"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-4 0-7 2-7 4.5V18h14v-1.5c0-2.5-3-4.5-7-4.5z"/></svg><%= locals.esAdmin ? 'Administrador' : 'Línea ' + locals.usuario %></span>
        <form method="post" action="/logout"><button type="submit" class="btn-salir" title="Cerrar sesión">Salir</button></form>
      </div>
    </nav>
    <% } %>
  </div>
</header>
<main id="contenido" class="contenido">
<% if (locals.msg) { %><div class="toast" role="status"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm-1 11.4L5.6 10 7 8.6l2 2 4-4L14.4 8 9 13.4z"/></svg><span><%= locals.msg %></span><button type="button" class="toast-cerrar" aria-label="Cerrar">×</button></div><% } %>
