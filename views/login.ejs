<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Entrar · FerreObras</title>
<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/style.css"></head>
<body class="login-body">
<form method="post" action="/login" class="login">
  <div class="marca grande">Ferre<b>Obras</b></div>
  <p class="sub">Seguimiento de obras de clientes importantes</p>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <label>Línea de WhatsApp
    <select name="linea" required>
      <% lineas.forEach(l => { %><option value="<%= l.numero %>"><%= l.numero %></option><% }) %>
    </select>
  </label>
  <label>Clave <input type="password" name="clave" required autofocus></label>
  <button type="submit" class="btn primario">Entrar</button>
</form>
</body></html>
