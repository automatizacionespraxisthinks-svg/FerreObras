<%- include('layout_head', { titulo: 'Planificador de rutas', mapa: true }) %>
<div class="pagina-cab">
  <div>
    <p class="sobre">Rutas de despacho</p>
    <h1>Planificador de rutas</h1>
  </div>
  <div class="acciones">
    <div class="segmentado" role="tablist" aria-label="Secciones del módulo de rutas">
      <a role="tab" aria-selected="true" class="activo" href="/rutas">Planificador</a>
      <a role="tab" aria-selected="false" href="/rutas/gestion">Gestión de rutas <span class="num"><%= rutas.length %></span></a>
    </div>
  </div>
</div>

<% if (!rutas.length) { %>
  <div class="vacio">
    <p>Todavía no hay rutas para planificar. Importa la agenda de ferreterías desde Excel o crea la primera ruta con sus municipios.</p>
    <a class="btn primario" href="/rutas/gestion">Ir a gestión de rutas</a>
  </div>
<% } else { %>
<div class="planificador" id="planificador">
  <section class="tarjeta plan-ruta" aria-label="Ruta a planificar">
    <div class="plan-ruta-fila">
      <label class="plan-select">Ruta
        <select id="sel-ruta">
          <% const grupos = [['Activas', rutas.filter(r => r.activa)], ['Inactivas', rutas.filter(r => !r.activa)]]; %>
          <% grupos.forEach(([titulo, lista]) => { if (!lista.length) return; %>
            <optgroup label="<%= titulo %>">
              <% lista.forEach(r => { %><option value="<%= r.id %>" <%= pedida === r.id ? 'selected' : '' %>><%= r.nombre %> · <%= r.paradas.join(' – ') %></option><% }) %>
            </optgroup>
          <% }) %>
        </select>
      </label>
      <label class="plan-fecha">Fecha de despacho <input type="date" id="fecha-despacho"></label>
    </div>
    <div class="plan-ruta-info" id="ruta-info"></div>
    <div class="resumen-chips plan-resumen" id="plan-resumen" aria-live="polite"></div>
  </section>

  <section class="tarjeta sin-relleno plan-mapa" aria-label="Mapa de la ruta">
    <div id="mapa-ruta" class="mapa" role="application" aria-label="Mapa con el recorrido y los clientes seleccionados"></div>
    <div class="mapa-panel" id="mapa-panel">
      <div class="mapa-recorrido" id="mapa-recorrido">Calculando recorrido…</div>
      <label class="mapa-opcion"><input type="checkbox" id="solo-con-clientes" checked> Solo municipios con clientes seleccionados</label>
      <label class="mapa-opcion"><input type="checkbox" id="regreso-sede" checked> Regresar a la sede</label>
      <a class="btn chico amarillo" id="abrir-gmaps" href="#" target="_blank" rel="noopener" hidden>Abrir en Google Maps</a>
    </div>
    <div class="mapa-leyenda" id="mapa-leyenda"></div>
    <div class="mapa-modo" id="mapa-modo" role="status" hidden><span id="mapa-modo-texto"></span><button type="button" class="btn chico" id="mapa-modo-cancelar">Cancelar</button></div>
    <p class="grafica-vacia mapa-error" id="mapa-error" hidden>No se pudo cargar el mapa. Verifica la conexión a internet; la lista de clientes funciona igual.</p>
  </section>

  <section class="tarjeta sin-relleno plan-clientes" aria-label="Clientes de la ruta">
    <div class="tabla-herr">
      <h2>Clientes a contactar</h2>
      <label class="buscador"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12.9 14.3a7 7 0 1 1 1.4-1.4l3.4 3.4-1.4 1.4-3.4-3.4zM8 13A5 5 0 1 0 8 3a5 5 0 0 0 0 10z"/></svg><input type="search" id="filtro-clientes" placeholder="Filtrar por nombre o teléfono…" aria-label="Filtrar clientes de la ruta"></label>
      <label class="filtro-estado">Estado
        <select id="filtro-estado"><option value="">Todos</option><% estados.forEach(e => { %><option value="<%= e.id %>"><%= e.nombre %></option><% }) %></select>
      </label>
    </div>
    <div class="plan-agregar">
      <div class="agregar-busqueda">
        <label class="buscador"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M9 3h2v6h6v2h-6v6H9v-6H3V9h6z"/></svg><input type="search" id="buscar-agregar" placeholder="Agregar un cliente de cualquier municipio…" autocomplete="off" aria-label="Buscar cliente para agregar a la ruta" aria-controls="sugerencias" aria-expanded="false"></label>
        <ul class="sugerencias" id="sugerencias" role="listbox" hidden></ul>
      </div>
      <button type="button" class="btn chico" id="btn-nuevo-cliente">Nuevo cliente</button>
    </div>
    <div class="grupos" id="grupos"><p class="vacio-tabla">Cargando clientes…</p></div>
    <div class="plan-pie">
      <span class="ayuda">Toca un chip para ver la ficha del cliente · la × lo quita de la ruta · los punteados se agregan con +</span>
      <a class="btn chico" id="btn-exportar" href="#"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M4 2h8l4 4v12H4V2zm7 1.5V7h3.5L11 3.5zM6 9h2.2l1.3 2 1.3-2H13l-2.3 3.2L13 16h-2.2l-1.3-2.1L8.2 16H6l2.4-3.8L6 9z"/></svg>Exportar a Excel</a>
      <button type="button" class="btn chico link" id="btn-reiniciar">Reiniciar planificación</button>
    </div>
  </section>
</div>

<dialog class="dialogo" id="dialogo-cliente" aria-labelledby="dialogo-titulo"><div id="dialogo-contenido"></div></dialog>
<datalist id="lista-municipios"><% municipios.forEach(m => { %><option value="<%= m.nombre %>"></option><% }) %></datalist>
<script id="datos-rutas" type="application/json"><%- JSON.stringify({ rutas: rutas.map(r => ({ id: r.id, nombre: r.nombre, activa: r.activa })), pedida }).replace(/</g, '\\u003c') %></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin="anonymous"></script>
<script src="/static/rutas.js" defer></script>
<% } %>
<%- include('layout_foot') %>
