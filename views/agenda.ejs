<%- include('layout_head', { titulo: 'Agenda de contactos' }) %>
<div class="pagina-cab">
  <div>
    <p class="sobre">Rutas de despacho</p>
    <h1>Agenda de contactos</h1>
  </div>
  <div class="acciones">
    <div class="segmentado" role="tablist" aria-label="Secciones del módulo de rutas">
      <a role="tab" aria-selected="false" href="/rutas">Planificador</a>
      <a role="tab" aria-selected="false" href="/rutas/gestion">Gestión de rutas</a>
      <a role="tab" aria-selected="true" class="activo" href="/agenda">Agenda <span class="num"><%= contactos.length %></span></a>
    </div>
    <a class="btn" id="btn-exportar" href="/agenda/export.xlsx"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M4 2h8l4 4v12H4V2zm7 1.5V7h3.5L11 3.5zM6 9h2.2l1.3 2 1.3-2H13l-2.3 3.2L13 16h-2.2l-1.3-2.1L8.2 16H6l2.4-3.8L6 9z"/></svg>Exportar a Excel</a>
    <button type="button" class="btn primario" id="btn-nuevo"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M9 3h2v6h6v2h-6v6H9v-6H3V9h6z"/></svg>Nuevo contacto</button>
  </div>
</div>

<section class="tarjeta sin-relleno agenda">
  <div class="tabla-herr agenda-herr">
    <label class="buscador"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12.9 14.3a7 7 0 1 1 1.4-1.4l3.4 3.4-1.4 1.4-3.4-3.4zM8 13A5 5 0 1 0 8 3a5 5 0 0 0 0 10z"/></svg><input type="search" id="buscar" placeholder="Buscar por nombre, teléfono, municipio, NIT…" aria-label="Buscar contactos"></label>
    <label class="filtro-estado">Tipo
      <select id="f-tipo"><option value="">Todos</option><option value="c">Ferreterías</option><option value="o">Clientes de obras</option></select>
    </label>
    <label class="filtro-estado">Municipio <select id="f-municipio"><option value="">Todos</option></select></label>
    <label class="filtro-estado">Ruta
      <select id="f-ruta"><option value="">Todas</option><% rutas.forEach(r => { %><option value="<%= r %>"><%= r %></option><% }) %></select>
    </label>
    <span class="conteo" id="conteo" aria-live="polite"></span>
  </div>
  <div class="tabla-scroll" id="tabla"><p class="vacio-tabla">Cargando contactos…</p></div>
  <div class="plan-pie"><span class="ayuda">Toca un encabezado para ordenar · toca el nombre para editar una ferretería o abrir la obra</span></div>
</section>

<dialog class="dialogo" id="dialogo-cliente" aria-labelledby="dialogo-titulo"><div id="dialogo-contenido"></div></dialog>
<datalist id="lista-municipios"><% municipios.forEach(m => { %><option value="<%= m.nombre %>"></option><% }) %></datalist>
<script id="datos-agenda" type="application/json"><%- JSON.stringify({ contactos, rutas, rutasPorMunicipio }).replace(/</g, '\\u003c') %></script>
<script src="/static/agenda.js" defer></script>
<%- include('layout_foot') %>
