<%# Layout de las vistas embebidas en Chatwoot: hoja de vida (vista 'hv', por defecto) y agenda del cliente (vista 'agenda').
    Sin cabecera, sin menú y sin botón Salir. %>
<% const vista = locals.vista || 'hv'; const esAgenda = vista === 'agenda'; %>
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title><%= esAgenda ? 'Agenda del cliente' : 'Hoja de vida' %> · FerreObras</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/static/style.css?v=<%= locals.versionEstaticos || '' %>">
<link rel="stylesheet" href="/static/hv.css?v=<%= locals.versionEstaticos || '' %>">
</head>
<body class="hv <%= esAgenda ? 'hv-vista-agenda' : '' %>">
<main class="hv-main" id="hv" aria-live="polite"
  data-vista="<%= vista %>"
  data-modo="<%= puente ? 'puente' : 'directo' %>"
  data-chatwoot-origin="<%= locals.chatwootOrigin || '' %>"
  data-clave="<%= locals.clave || '' %>"
  data-celular="<%= locals.celular || '' %>">
  <div id="hv-contenido">
    <% if (locals.error) { %>
      <div class="hv-estado error"><p><%= error %></p></div>
    <% } else if (puente) { %>
      <div class="hv-estado" id="hv-estado"><span class="hv-cargando" aria-hidden="true"></span><p>Conectando con Chatwoot…</p></div>
    <% } else if (esAgenda) { %>
      <div class="hv-estado" id="hv-estado"><span class="hv-cargando" aria-hidden="true"></span><p>Cargando la agenda…</p></div>
    <% } else { %>
      <%- include('hv_contenido') %>
    <% } %>
  </div>
</main>
<div class="hv-toast" id="hv-toast" role="status" hidden></div>
<% if (!esAgenda) { %>
<datalist id="hv-municipios"><% (locals.municipios || []).forEach(m => { %><option value="<%= m.nombre %>"></option><% }) %></datalist>
<datalist id="hv-productos"><% (locals.productos || []).forEach(p => { %><option value="<%= p %>"></option><% }) %></datalist>
<%# Fila de código de precio que se agrega con "+ Agregar código" %>
<template id="hv-plantilla-precio">
  <div class="hv-precio" data-precio>
    <input data-producto list="hv-productos" maxlength="60" placeholder="Tipo de producto" aria-label="Tipo de producto" autocomplete="off">
    <select data-codigo aria-label="Código de precio">
      <option value="">Sin código</option>
      <% (locals.codigosPrecio || []).forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
    </select>
    <input data-notas maxlength="300" placeholder="Notas" aria-label="Notas del código de precio" autocomplete="off">
    <button type="button" class="hv-precio-quitar" data-hv="quitar-precio" aria-label="Quitar este código" title="Quitar este código">×</button>
  </div>
</template>
<% } %>
<script src="/static/hv_comun.js?v=<%= locals.versionEstaticos || '' %>"></script>
<script src="/static/<%= esAgenda ? 'hv_agenda' : 'hv' %>.js?v=<%= locals.versionEstaticos || '' %>" defer></script>
</body>
</html>
