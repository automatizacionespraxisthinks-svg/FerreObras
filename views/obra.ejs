<%- include('layout_head', { titulo: obra.cliente }) %>
<% const hoyISO = hoy(); %>
<div class="encabezado">
  <div>
    <h1><%= obra.cliente %> <span class="estado-obra <%= obra.estado %>"><%= obra.estado === 'activa' ? 'en curso' : 'cerrada' %></span></h1>
    <p class="sub"><%= obra.obra %><%= obra.direccion_obra ? ' · ' + obra.direccion_obra : '' %> · Línea <%= obra.linea %></p>
  </div>
  <div class="acciones">
    <a class="btn" href="/obras/<%= obra.id %>/export.csv">Exportar a Excel</a>
    <a class="btn" href="/obras/<%= obra.id %>/editar">Editar datos</a>
    <% if (obra.estado === 'activa') { %>
      <form method="post" action="/obras/<%= obra.id %>/cerrar" onsubmit="return confirm('¿Cerrar la obra? Se eliminan los avisos pendientes del calendario y, si el cliente no tiene otra obra activa, pasa a seguimiento de cliente inactivo.')"><button class="btn peligro">Cerrar obra</button></form>
    <% } else { %>
      <form method="post" action="/obras/<%= obra.id %>/reabrir"><button class="btn">Reabrir</button></form>
    <% } %>
  </div>
</div>
<% if (msg) { %><p class="aviso-ok"><%= msg %></p><% } %>

<section class="ficha">
  <dl>
    <dt>Celular</dt><dd><%= obra.celular %></dd>
    <dt>Dirección del cliente</dt><dd><%= obra.direccion_cliente || '—' %></dd>
    <dt>Maestro</dt><dd><%= obra.maestro || '—' %><%= obra.celular_maestro ? ' · ' + obra.celular_maestro : '' %></dd>
    <dt>Programación</dt><dd>cada <%= obra.intervalo_dias %> días, aviso <%= obra.dias_aviso %> días antes</dd>
    <% if (obra.notas) { %><dt>Notas</dt><dd><%= obra.notas %></dd><% } %>
  </dl>
  <div class="precios">
    <% productos.forEach(p => { const c = obra.precios && obra.precios[p.nombre]; %>
      <span class="precio"><%= p.nombre %> <b><%= c || '—' %></b></span>
    <% }) %>
  </div>
</section>

<h2>Etapas y ventas</h2>
<p class="ayuda">Marca lo que compró el cliente en cada etapa y guarda la fila. Si cambias la fecha de una etapa, las siguientes se recalculan solas y el calendario se actualiza.</p>

<div class="etapas">
<% etapas.forEach(e => {
     const dias = e.fecha_aviso ? diffDays(hoyISO, e.fecha_aviso) : null;
     let clase = e.estado;
     if (e.estado === 'pendiente' && dias !== null) { if (dias < 0) clase += ' vencido'; else if (dias <= 3) clase += ' pronto'; } %>
  <form method="post" action="/obras/<%= obra.id %>/etapas/<%= e.id %>" class="etapa <%= clase %>">
    <div class="etapa-cab">
      <input name="nombre" value="<%= e.nombre %>" class="nombre-etapa" <%= e.orden === 0 ? 'readonly' : '' %>>
      <% if (e.orden > 0) { %>
        <label class="mini">Aviso <b><%= fmt(e.fecha_aviso) %></b>
          <% if (e.estado === 'pendiente' && dias !== null) { %><span class="chip <%= dias < 0 ? 'vencido' : dias === 0 ? 'hoy' : dias <= 3 ? 'pronto' : '' %>"><%= dias < 0 ? `hace ${-dias} d` : dias === 0 ? 'hoy' : `en ${dias} d` %></span><% } %>
        </label>
      <% } %>
      <select name="estado" class="estado">
        <option value="pendiente" <%= e.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
        <option value="vendida" <%= e.estado === 'vendida' ? 'selected' : '' %>>Vendida</option>
        <option value="sin_venta" <%= e.estado === 'sin_venta' ? 'selected' : '' %>>Sin venta</option>
      </select>
    </div>
    <div class="etapa-fechas">
      <label>Fecha <%= e.orden === 0 ? 'de cimentación' : 'programada' %> <input type="date" name="fecha_programada" value="<%= e.fecha_programada %>"></label>
      <% if (e.orden > 0) { %>
      <label>Fecha real <input type="date" name="fecha_real" value="<%= e.fecha_real || '' %>"></label>
      <label>Intervalo <input type="number" name="intervalo_dias" min="1" value="<%= e.intervalo_dias %>" class="corto"> d</label>
      <label>Aviso <input type="number" name="dias_aviso" min="1" value="<%= e.dias_aviso %>" class="corto"> d antes</label>
      <% } %>
    </div>
    <div class="ventas">
      <% productos.forEach(p => { const v = ventas[`${e.id}:${p.id}`] || {}; %>
        <div class="venta">
          <label class="check"><input type="checkbox" name="venta_<%= p.id %>" <%= v.vendido ? 'checked' : '' %>> <%= p.nombre %></label>
          <input name="detalle_<%= p.id %>" value="<%= v.detalle || '' %>" placeholder="cantidad / detalle" class="detalle">
        </div>
      <% }) %>
    </div>
    <div class="etapa-pie">
      <input name="notas" value="<%= e.notas || '' %>" placeholder="Notas de la etapa" class="notas">
      <button type="submit" class="btn primario chico">Guardar</button>
      <% if (e.orden > 0 && e.estado === 'pendiente') { %>
        <button type="submit" formaction="/obras/<%= obra.id %>/etapas/<%= e.id %>/eliminar" formnovalidate class="btn chico link" onclick="return confirm('¿Eliminar esta etapa?')">Eliminar</button>
      <% } %>
    </div>
  </form>
<% }) %>
</div>

<form method="post" action="/obras/<%= obra.id %>/etapas" class="agregar-etapa">
  <strong>Agregar etapa al final</strong>
  <label>Nombre <input name="nombre" placeholder="Cubierta, Acabados, Placa 5…" required></label>
  <label>Intervalo <input type="number" name="intervalo_dias" min="1" value="<%= obra.intervalo_dias %>" class="corto"> d después de la anterior</label>
  <label>Aviso <input type="number" name="dias_aviso" min="1" value="<%= obra.dias_aviso %>" class="corto"> d antes</label>
  <button type="submit" class="btn chico">Agregar</button>
</form>
<%- include('layout_foot') %>
