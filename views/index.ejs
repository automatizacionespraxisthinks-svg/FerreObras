<%- include('layout_head', { titulo: 'Obras' }) %>
<div class="pagina-cab">
  <div>
    <p class="sobre">Seguimiento</p>
    <h1><%= ver === 'cerradas' ? 'Obras cerradas' : 'Obras en curso' %></h1>
  </div>
  <div class="acciones">
    <div class="segmentado" role="tablist" aria-label="Estado de las obras">
      <a role="tab" aria-selected="<%= ver === 'activas' %>" class="<%= ver === 'activas' ? 'activo' : '' %>" href="/">En curso <span class="num"><%= conteos.activas %></span></a>
      <a role="tab" aria-selected="<%= ver === 'cerradas' %>" class="<%= ver === 'cerradas' ? 'activo' : '' %>" href="/?ver=cerradas">Cerradas <span class="num"><%= conteos.cerradas %></span></a>
    </div>
    <a class="btn primario" href="/obras/nueva"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M9 3h2v6h6v2h-6v6H9v-6H3V9h6z"/></svg>Nueva obra</a>
  </div>
</div>

<% if (ver === 'activas' && obras.length) { %>
<div class="resumen-chips">
  <span class="chip-kpi <%= resumen.vencidos ? 'vencido' : '' %>"><b><%= resumen.vencidos %></b> avisos vencidos</span>
  <span class="chip-kpi <%= resumen.hoy ? 'hoy' : '' %>"><b><%= resumen.hoy %></b> para hoy</span>
  <span class="chip-kpi"><b><%= resumen.semana %></b> en los próximos 7 días</span>
</div>
<% } %>

<% if (!obras.length) { %>
  <div class="vacio">
    <p>Todavía no hay obras <%= ver === 'cerradas' ? 'cerradas' : 'registradas' %>.</p>
    <% if (ver !== 'cerradas') { %><a class="btn primario" href="/obras/nueva">Registrar la primera obra</a><% } %>
  </div>
<% } else { %>
<div class="tarjeta sin-relleno">
  <div class="tabla-herr">
    <label class="buscador"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12.9 14.3a7 7 0 1 1 1.4-1.4l3.4 3.4-1.4 1.4-3.4-3.4zM8 13A5 5 0 1 0 8 3a5 5 0 0 0 0 10z"/></svg><input type="search" id="buscar-obras" placeholder="Buscar cliente, obra, celular o línea…" aria-label="Buscar obras"></label>
    <span class="conteo" id="conteo-obras"><%= obras.length %> obra<%= obras.length === 1 ? '' : 's' %></span>
  </div>
  <div class="tabla-scroll">
  <table class="tabla obras" id="tabla-obras">
    <thead><tr><th>Cliente</th><th>Obra</th><th>Línea</th><th>Avance</th><th>Próxima etapa</th><th>Aviso</th></tr></thead>
    <tbody>
    <% obras.forEach(o => {
         let clase = '', texto = '—';
         if (o.dias_para_aviso !== null && o.dias_para_aviso !== undefined) {
           if (o.dias_para_aviso < 0) { clase = 'vencido'; texto = `hace ${-o.dias_para_aviso} d`; }
           else if (o.dias_para_aviso === 0) { clase = 'hoy'; texto = 'hoy'; }
           else if (o.dias_para_aviso <= 3) { clase = 'pronto'; texto = `en ${o.dias_para_aviso} d`; }
           else { texto = `en ${o.dias_para_aviso} d`; }
         }
         const pctAvance = o.total_etapas ? Math.round(o.etapas_hechas / o.total_etapas * 100) : 0; %>
      <tr class="fila <%= clase %>" data-href="/obras/<%= o.id %>" data-buscar="<%= [o.cliente, o.obra, o.celular, o.linea, o.direccion_obra].join(' ').toLowerCase() %>">
        <td data-etiqueta="Cliente"><a href="/obras/<%= o.id %>" class="enlace-fuerte"><%= o.cliente %></a><small><%= o.celular %></small></td>
        <td data-etiqueta="Obra"><%= o.obra %><small><%= o.direccion_obra || '' %></small></td>
        <td data-etiqueta="Línea"><span class="etiqueta-linea"><%= o.linea %></span></td>
        <td data-etiqueta="Avance">
          <div class="avance"><div class="avance-barra" style="width:<%= pctAvance %>%"></div></div>
          <small><%= o.etapas_hechas %> de <%= o.total_etapas %> etapas · <%= o.etapas_vendidas %> vendida<%= o.etapas_vendidas === 1 ? '' : 's' %></small>
        </td>
        <td data-etiqueta="Próxima etapa"><% if (o.proxima) { %><%= o.proxima.nombre %><small><%= fmt(o.proxima.fecha_programada) %></small><% } else { %><span class="muted">Sin etapas pendientes</span><% } %></td>
        <td data-etiqueta="Aviso"><span class="chip <%= clase %>"><%= texto %></span><% if (o.proxima && o.proxima.fecha_aviso) { %><small><%= fmt(o.proxima.fecha_aviso) %></small><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <p class="vacio-busqueda" id="sin-resultados" hidden>Ninguna obra coincide con la búsqueda.</p>
</div>
<% } %>
<%- include('layout_foot') %>
