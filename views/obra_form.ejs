<%- include('layout_head', { titulo: obra && obra.id ? 'Editar obra' : 'Nueva obra' }) %>
<% const v = (k) => (obra && obra[k] != null) ? obra[k] : ''; const editando = !!(obra && obra.id); %>
<div class="encabezado">
  <h1><%= editando ? 'Editar obra' : 'Nueva obra' %></h1>
  <% if (editando) { %><a class="btn" href="/obras/<%= obra.id %>">Volver a la obra</a><% } %>
</div>
<% if (error) { %><p class="error"><%= error %></p><% } %>

<form method="post" action="<%= editando ? `/obras/${obra.id}/editar` : '/obras' %>" class="formulario">
  <fieldset>
    <legend>Cliente</legend>
    <label>Nombre del cliente <input name="cliente" value="<%= v('cliente') %>" required></label>
    <label>Celular <input name="celular" value="<%= v('celular') %>" required inputmode="tel"></label>
    <label>Dirección del cliente <input name="direccion_cliente" value="<%= v('direccion_cliente') %>"></label>
    <label>Línea de WhatsApp que hace el seguimiento
      <select name="linea" required>
        <% lineas.forEach(l => { %><option value="<%= l.numero %>" <%= (v('linea') || linea) === l.numero ? 'selected' : '' %>><%= l.numero %> · <%= l.correo %></option><% }) %>
      </select>
    </label>
  </fieldset>

  <fieldset>
    <legend>Obra</legend>
    <label>Obra o municipio <input name="obra" value="<%= v('obra') %>" required placeholder="Paipa"></label>
    <label>Dirección de la obra <input name="direccion_obra" value="<%= v('direccion_obra') %>"></label>
    <label>Maestro <input name="maestro" value="<%= v('maestro') %>"></label>
    <label>Celular del maestro <input name="celular_maestro" value="<%= v('celular_maestro') %>" inputmode="tel"></label>
    <label>Notas <textarea name="notas" rows="2"><%= v('notas') %></textarea></label>
  </fieldset>

  <fieldset>
    <legend>Programación</legend>
    <% if (!editando) { %>
    <label>Fecha de cimentación <input type="date" name="fecha_cimentacion" value="<%= v('fecha_cimentacion') %>" required></label>
    <label>Número de placas <input type="number" name="num_placas" min="1" max="30" value="<%= v('num_placas') || 4 %>" required></label>
    <% } %>
    <label>Intervalo entre placas (días) <input type="number" name="intervalo_dias" min="1" value="<%= v('intervalo_dias') || 15 %>" required></label>
    <label>Días de aviso antes de cada placa <input type="number" name="dias_aviso" min="1" value="<%= v('dias_aviso') || 8 %>" required></label>
    <% if (!editando) { %><p class="ayuda">Al guardar se crean la cimentación y las placas con sus fechas de aviso. Después las puedes ajustar una por una.</p>
    <% } else { %><p class="ayuda">Estos valores aplican a las etapas que agregues de aquí en adelante; las existentes se ajustan desde el detalle de la obra.</p><% } %>
  </fieldset>

  <fieldset>
    <legend>Código de precio por línea</legend>
    <div class="grilla-precios">
    <% const precios = (obra && obra.precios) || {}; productos.forEach(p => { const actual = precios[p.nombre] || (obra ? obra[`precio_${p.id}`] : '') || ''; %>
      <label><%= p.nombre %>
        <select name="precio_<%= p.id %>">
          <option value="">—</option>
          <% ['R+R','R','E','F'].forEach(c => { %><option value="<%= c %>" <%= actual === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </label>
    <% }) %>
    </div>
  </fieldset>

  <div class="acciones">
    <button type="submit" class="btn primario"><%= editando ? 'Guardar cambios' : 'Crear obra y programar seguimientos' %></button>
  </div>
</form>
<%- include('layout_foot') %>
