<%- include('layout_head', { titulo: 'Gestión de rutas' }) %>
<% const activas = rutas.filter(r => r.activa).length; %>
<div class="pagina-cab">
  <div>
    <p class="sobre">Rutas de despacho</p>
    <h1>Gestión de rutas</h1>
  </div>
  <div class="acciones">
    <div class="segmentado" role="tablist" aria-label="Secciones del módulo de rutas">
      <a role="tab" aria-selected="false" href="/rutas">Planificador</a>
      <a role="tab" aria-selected="true" class="activo" href="/rutas/gestion">Gestión de rutas <span class="num"><%= rutas.length %></span></a>
    </div>
    <button type="button" class="btn" id="btn-importar" aria-expanded="false" aria-controls="form-importar"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M4 2h8l4 4v12H4V2zm7 1.5V7h3.5L11 3.5zM6 9h2.2l1.3 2 1.3-2H13l-2.3 3.2L13 16h-2.2l-1.3-2.1L8.2 16H6l2.4-3.8L6 9z"/></svg>Importar agenda Excel</button>
    <a class="btn primario" href="/rutas/nueva"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M9 3h2v6h6v2h-6v6H9v-6H3V9h6z"/></svg>Nueva ruta</a>
  </div>
</div>

<form id="form-importar" class="tarjeta importar" <%= rutas.length ? 'hidden' : '' %>>
  <div class="importar-texto">
    <h2 class="tarjeta-titulo">Importar agenda de ferreterías</h2>
    <p class="ayuda">Sube el Excel que usaban las asesoras. Se leen las hojas con columnas <b>CLIENTE</b> (o NOMBRES) y <b>MUNICIPIO</b> (o CIUDAD) y, si existe, el <b>CRONOGRAMA RUTAS</b> para crear las rutas con sus municipios y frecuencia. Los clientes repetidos se reconocen por celular o por nombre y municipio: solo se completan los datos que falten, nunca se borra lo editado en la aplicación.</p>
  </div>
  <div class="importar-accion">
    <label>Archivo .xlsx <input type="file" name="archivo" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required></label>
    <button type="submit" class="btn primario">Importar</button>
    <span class="estado-carga" id="estado-importar" aria-live="polite"></span>
  </div>
</form>

<div class="resumen-chips">
  <span class="chip-kpi"><b><%= activas %></b> ruta<%= activas === 1 ? '' : 's' %> activa<%= activas === 1 ? '' : 's' %></span>
  <span class="chip-kpi"><b><%= totalFerreterias %></b> ferretería<%= totalFerreterias === 1 ? '' : 's' %> en el directorio</span>
  <span class="chip-kpi"><b><%= totalObras %></b> cliente<%= totalObras === 1 ? '' : 's' %> de obras en curso</span>
  <% const sinRutaTotal = sinRuta.reduce((n, s) => n + s.n, 0); if (sinRutaTotal) { %><span class="chip-kpi hoy"><b><%= sinRutaTotal %></b> ferretería<%= sinRutaTotal === 1 ? '' : 's' %> fuera de toda ruta activa</span><% } %>
</div>

<% if (!rutas.length) { %>
  <div class="vacio">
    <p>Todavía no hay rutas. Importa la agenda de Excel o crea la primera ruta con sus municipios.</p>
    <a class="btn primario" href="/rutas/nueva">Crear la primera ruta</a>
  </div>
<% } else { %>
<div class="tarjeta sin-relleno">
  <div class="tabla-herr">
    <label class="buscador"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12.9 14.3a7 7 0 1 1 1.4-1.4l3.4 3.4-1.4 1.4-3.4-3.4zM8 13A5 5 0 1 0 8 3a5 5 0 0 0 0 10z"/></svg><input type="search" id="buscar-rutas" placeholder="Buscar ruta o municipio…" aria-label="Buscar rutas"></label>
    <span class="conteo" id="conteo-rutas"><%= rutas.length %> ruta<%= rutas.length === 1 ? '' : 's' %></span>
  </div>
  <div class="tabla-scroll">
  <table class="tabla tabla-rutas" id="tabla-rutas">
    <thead><tr><th>Ruta</th><th>Municipios en orden</th><th>Programación</th><th>Clientes</th><th>Estado</th><th class="col-accion"></th></tr></thead>
    <tbody>
    <% rutas.forEach(r => { %>
      <tr class="<%= r.activa ? '' : 'inactiva' %>" data-buscar="<%= [r.nombre, r.descripcion, ...r.paradas].join(' ').toLowerCase() %>">
        <td data-etiqueta="Ruta">
          <span class="ruta-nombre"><span class="ruta-color" style="background:<%= r.color %>"></span><a class="enlace-fuerte" href="/rutas?ruta=<%= r.id %>"><%= r.nombre %></a></span>
          <small><%= r.descripcion || (r.sede_nombre ? 'Sale de ' + r.sede_nombre : 'Sin sede de salida') %></small>
        </td>
        <td data-etiqueta="Municipios">
          <ol class="paradas-chips">
            <% r.paradas_info.forEach((p, i) => { %><li class="parada-chip <%= p.clientes ? '' : 'sin-clientes' %>" title="<%= p.clientes %> cliente<%= p.clientes === 1 ? '' : 's' %><%= p.catalogo ? '' : ' · municipio fuera del catálogo: se ubica en el mapa por búsqueda' %>"><span class="parada-chip-num"><%= i + 1 %></span><%= p.nombre %><% if (p.clientes) { %> <b><%= p.clientes %></b><% } %></li><% }) %>
          </ol>
        </td>
        <td data-etiqueta="Programación"><%= r.frecuencia || '—' %><small><%= r.dias || '' %><%= r.proximo_despacho ? (r.dias ? ' · ' : '') + 'despacho ' + fmt(r.proximo_despacho) : '' %></small></td>
        <td data-etiqueta="Clientes"><b><%= r.ferreterias %></b> ferreterías<small><%= r.obras %> de obras · <%= r.seleccionados %> seleccionados<%= r.despachos ? ' · ' + r.despachos + ' despacho' + (r.despachos === 1 ? '' : 's') : '' %></small></td>
        <td data-etiqueta="Estado"><span class="chip <%= r.activa ? 'ok' : '' %>"><%= r.activa ? 'Activa' : 'Inactiva' %></span></td>
        <td class="col-accion">
          <div class="acciones-fila">
            <a class="btn chico primario" href="/rutas?ruta=<%= r.id %>">Planificar</a>
            <a class="btn chico" href="/rutas/<%= r.id %>/editar">Editar</a>
            <form method="post" action="/rutas/<%= r.id %>/estado"><button class="btn chico link"><%= r.activa ? 'Desactivar' : 'Activar' %></button></form>
            <form method="post" action="/rutas/<%= r.id %>/eliminar" data-confirmar="¿Eliminar la ruta &quot;<%= r.nombre %>&quot;? Se borra también su planificación. Los clientes no se eliminan."><button class="btn chico link">Eliminar</button></form>
          </div>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <p class="vacio-busqueda" id="sin-rutas" hidden>Ninguna ruta coincide con la búsqueda.</p>
</div>
<% } %>

<% if (sinRuta.length) { %>
<section class="tarjeta sin-ruta">
  <h2 class="tarjeta-titulo">Ferreterías en municipios sin ruta activa</h2>
  <p class="ayuda">Agrega estos municipios a una ruta para que sus clientes aparezcan en el planificador.</p>
  <div class="chips-lista">
    <% sinRuta.forEach(s => { %><span class="chip-kpi"><b><%= s.n %></b> <%= s.nombre %></span><% }) %>
  </div>
</section>
<% } %>
<script src="/static/rutas.js" defer></script>
<%- include('layout_foot') %>
