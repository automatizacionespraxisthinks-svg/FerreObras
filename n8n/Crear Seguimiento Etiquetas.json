    {
      "parameters": {
        "jsCode": "// ================= CONFIGURACIÓN =================\nconst TZ = 'America/Bogota';\n// Los eventos en Calendar son de todo el día (sin hora); el mensaje lo envía el cron de las 8:00 a. m.\n\n// Invitado del evento de Calendar según el inbox de Chatwoot\nconst INBOX_EMAIL = {\n  1: 'ferreaceros.3232@gmail.com',\n  2: 'ferreaceros.3333@gmail.com',\n  3: 'ferreaceros.3434@gmail.com',\n  4: 'ferreacerossas.3535@gmail.com'\n};\nconst DEFAULT_EMAIL = 'ferreaceros.3434@gmail.com';\n\n// Etiqueta de Chatwoot -> configuración del seguimiento.\n// followup_type es ÚNICO por etiqueta. motivo decide el tipo de mensaje.\n// prioridad (1 alta, 2 media, 3 baja) es la que se muestra en el título del evento y en la agenda de FerreObras.\nconst FOLLOWUP_MAP = {\n  seg_diario:          { followup_type: 'quotation_daily',     motivo: 'cotizacion',  customer_type: 'individual',     interval_days: 1,   max_sends: 2, prioridad: 1, tipo_es: 'Cotización (diario)' },\n  seg_semanal:         { followup_type: 'construction_weekly', motivo: 'obra',        customer_type: 'individual',     interval_days: 7,   max_sends: 1, prioridad: 2, tipo_es: 'Seguimiento de obra (semanal)' },\n  seg_15d_ferreterias: { followup_type: 'hardware_store_15d',  motivo: 'ferreterias', customer_type: 'hardware_store', interval_days: 15,  max_sends: 1, prioridad: 2, tipo_es: 'Ferretería (quincenal)' },\n  seg_15d_cotizacion:  { followup_type: 'quotation_15d',       motivo: 'cotizacion',  customer_type: 'individual',     interval_days: 15,  max_sends: 1, prioridad: 2, tipo_es: 'Cotización (quincenal)' },\n  seg_mensual:         { followup_type: 'inactive_30',         motivo: 'inactivo',    customer_type: 'individual',     interval_days: 30,  max_sends: 1, prioridad: 3, tipo_es: 'Cliente inactivo (mensual)' },\n  seg_2_meses:         { followup_type: 'inactive_60',         motivo: 'inactivo',    customer_type: 'individual',     interval_days: 60,  max_sends: 1, prioridad: 3, tipo_es: 'Cliente inactivo (2 meses)' },\n  seg_6_meses:         { followup_type: 'inactive_180',        motivo: 'inactivo',    customer_type: 'individual',     interval_days: 180, max_sends: 1, prioridad: 3, tipo_es: 'Cliente inactivo (6 meses)' }\n};\n\n// Etiquetas antiguas que aún pueden existir en Chatwoot -> etiqueta oficial\nconst ALIAS = {\n  seg_30_dias: 'seg_mensual',\n  seg_15_dias: 'seg_15d_ferreterias',\n  seg_obrasenproceso: 'seg_semanal'\n};\nconst norm = l => ALIAS[l] || l;\n\n// Todas las formas (oficial + alias) con que una etiqueta puede aparecer en Chatwoot\nconst formasDe = label => [label, ...Object.keys(ALIAS).filter(a => ALIAS[a] === label)];\n\n// Tipo -> etiqueta oficial (para filas de la BD)\nconst LABEL_BY_TYPE = Object.fromEntries(Object.entries(FOLLOWUP_MAP).map(([l, c]) => [c.followup_type, l]));\n\n// Fecha del siguiente envío: hoy + intervalo, y si cae en fin de semana pasa al lunes\n// (el cron solo corre de lunes a viernes). Devuelve un DateTime a las 00:00 de Bogotá.\nfunction siguienteFecha(desde, intervalDays) {\n  let f = desde.startOf('day').plus({ days: intervalDays });\n  if (f.weekday === 6) f = f.plus({ days: 2 });\n  else if (f.weekday === 7) f = f.plus({ days: 1 });\n  return f;\n}\n\n// ================= DATOS DEL WEBHOOK =================\nconst d = $input.first().json;\nconst actuales   = [...new Set((d.Etiquetas || []).map(norm))];\nconst anteriores = [...new Set((d['Etiquetas Anteriores'] || []).map(norm))];\n\nconst nuevas    = actuales.filter(l => !anteriores.includes(l) && FOLLOWUP_MAP[l]);\nconst removidas = anteriores.filter(l => !actuales.includes(l) && FOLLOWUP_MAP[l]);\n\nif (!nuevas.length && !removidas.length) return [];\n\n// ================= TELÉFONO: SIEMPRE DEBE EXISTIR =================\nconst digits = s => String(s || '').replace(/\\D/g, '');\nlet phone = digits(d.Numero);\nif (!phone && String(d.JID || '').endsWith('@c.us')) phone = digits(String(d.JID).split('@')[0]);\nif (phone.length < 8) phone = '';\n\nconst conversationId = d['ID Conversacion'];\nconst customerName   = d.Nombre;\nconst inboxId        = Number(d.inbox_id);\n\nif (!phone) {\n  if (!nuevas.length) return [];  // solo removidas y sin número: nada que hacer (evita ciclo al retirar la etiqueta)\n  return [{ json: {\n    action: 'sin_numero',\n    conversation_id: conversationId,\n    contact_id: d.contact_id,\n    customer_name: customerName,\n    etiquetas: nuevas,\n    etiquetas_a_quitar: nuevas.flatMap(formasDe)\n  }}];\n}\nphone = '+' + phone;\n\n// ================= FECHAS =================\nconst ahora = DateTime.now().setZone(TZ);\nconst fechaMsg = d.Fecha ? new Date(Number(d.Fecha) * 1000).toISOString() : ahora.toISO();\nconst attendeeEmail = INBOX_EMAIL[inboxId] || DEFAULT_EMAIL;\nconst linea = (attendeeEmail.match(/\\d{4}/) || [''])[0]; // línea de WhatsApp responsable, según el inbox\n\n// ================= SALIDA =================\nconst out = [];\n\nfor (const label of nuevas) {\n  const cfg = FOLLOWUP_MAP[label];\n  const primerEnvio = siguienteFecha(ahora, cfg.interval_days);\n\n  // Calendar: solo tantos eventos como envíos habrá.\n  //  - 1 envío  -> evento único en la fecha del envío\n  //  - N envíos -> recurrencia con COUNT=N (el diario salta fines de semana igual que el cron)\n  let rrule = null;\n  if (cfg.max_sends > 1) {\n    rrule = cfg.interval_days === 1\n      ? `RRULE:FREQ=DAILY;BYDAY=MO,TU,WE,TH,FR;COUNT=${cfg.max_sends}`\n      : `RRULE:FREQ=DAILY;INTERVAL=${cfg.interval_days};COUNT=${cfg.max_sends}`;\n  }\n  const eventoFecha = primerEnvio.toISODate(); // evento de todo el día\n\n  out.push({ json: {\n    action: 'create',\n    label,\n    conversation_id: conversationId,\n    inbox_id: inboxId,\n    phone,\n    customer_name: customerName,\n    customer_type: cfg.customer_type,\n    followup_type: cfg.followup_type,\n    motivo: cfg.motivo,\n    tipo_es: cfg.tipo_es,\n    interval_days: cfg.interval_days,\n    max_sends: cfg.max_sends,\n    rrule,\n    evento_fecha: eventoFecha,\n    evento_fin_fecha: primerEnvio.plus({ days: 1 }).toISODate(), // fin exclusivo, como lo pide la API de Calendar\n    attendee_email: attendeeEmail,\n    linea,\n    prioridad: cfg.prioridad,\n    // Título con el mismo formato de la agenda de FerreObras: \"#prioridad - Tarea - responsable\"\n    titulo: `${cfg.prioridad} - Seguimiento ${cfg.tipo_es.toLowerCase()} · ${customerName || phone} - ${linea}`,\n    descripcion: [\n      `Cliente: ${customerName || 'sin nombre'} · ${phone}`,\n      `Responsable: línea ${linea}`,\n      `Prioridad: ${cfg.prioridad}`,\n      `Seguimiento automático: ${cfg.tipo_es} (etiqueta ${label})`,\n      `Envíos programados: ${cfg.max_sends}${cfg.max_sends > 1 ? ' · cada ' + cfg.interval_days + ' día(s)' : ''}`,\n      'Programado por etiqueta desde Chatwoot; se elimina al quitar la etiqueta.'\n    ].join('\\n'),\n    status: 'active',\n    stage: null,\n    summary: null,\n    last_customer_message_at: fechaMsg,\n    next_followup_at: primerEnvio.toISO(),\n    created_at: ahora.toISO(),\n    updated_at: ahora.toISO()\n  }});\n}\n\nfor (const label of removidas) {\n  out.push({ json: {\n    action: 'close',\n    label,\n    conversation_id: conversationId,\n    phone,\n    followup_type: FOLLOWUP_MAP[label].followup_type\n  }});\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1216,
