{
  "name": "VIP_Agenda",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vip-agenda",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook vip-agenda",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "vip-agenda",
      "notes": "Recibe de FerreObras { evento, tarea, ts }. evento: tarea_creada | tarea_actualizada | tarea_eliminada. La tarea ya trae titulo (\"1 - Tarea - 3232\"), descripcion, inicio, fin, todo_el_dia, color_id, correo_responsable y google_event_id."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [ { "id": "c1", "leftValue": "={{ $json.body.evento }}", "rightValue": "tarea_creada", "operator": { "type": "string", "operation": "equals" } } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "crear"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [ { "id": "c2", "leftValue": "={{ $json.body.evento }}", "rightValue": "tarea_actualizada", "operator": { "type": "string", "operation": "equals" } } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "actualizar"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
                "conditions": [ { "id": "c3", "leftValue": "={{ $json.body.evento }}", "rightValue": "tarea_eliminada", "operator": { "type": "string", "operation": "equals" } } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "eliminar"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "¿Qué pasó?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [240, 300]
    },
    {
      "parameters": {
        "calendar": { "__rl": true, "mode": "list", "value": "primary", "cachedResultName": "Calendario de la cuenta maestra" },
        "start": "={{ $json.body.tarea.inicio }}",
        "end": "={{ $json.body.tarea.fin }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "allday": "={{ $json.body.tarea.todo_el_dia ? 'yes' : 'no' }}",
          "attendees": "={{ $json.body.tarea.correo_responsable ? [$json.body.tarea.correo_responsable] : [] }}",
          "color": "={{ $json.body.tarea.color_id }}",
          "description": "={{ $json.body.tarea.descripcion }}",
          "guestsCanModify": true,
          "sendUpdates": "all",
          "summary": "={{ $json.body.tarea.titulo }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Crear evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [520, 120],
      "notes": "Crea el evento en el calendario de la cuenta maestra e invita al correo de la línea responsable (lineas_whatsapp). Elige el calendario tras enlazar la credencial."
    },
    {
      "parameters": {
        "operation": "update",
        "calendar": { "__rl": true, "mode": "list", "value": "primary", "cachedResultName": "Calendario de la cuenta maestra" },
        "eventId": "={{ $json.body.tarea.google_event_id }}",
        "useDefaultReminders": true,
        "updateFields": {
          "allday": "={{ $json.body.tarea.todo_el_dia ? 'yes' : 'no' }}",
          "attendees": "={{ $json.body.tarea.correo_responsable ? [$json.body.tarea.correo_responsable] : [] }}",
          "color": "={{ $json.body.tarea.color_id }}",
          "description": "={{ $json.body.tarea.descripcion }}",
          "end": "={{ $json.body.tarea.fin }}",
          "sendUpdates": "all",
          "start": "={{ $json.body.tarea.inicio }}",
          "summary": "={{ $json.body.tarea.titulo }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Actualizar evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [520, 300],
      "onError": "continueErrorOutput",
      "notes": "Si el evento ya no existe en Google (lo borraron a mano), la salida de error lo vuelve a crear."
    },
    {
      "parameters": {
        "operation": "delete",
        "calendar": { "__rl": true, "mode": "list", "value": "primary", "cachedResultName": "Calendario de la cuenta maestra" },
        "eventId": "={{ $json.body.tarea.google_event_id }}",
        "options": { "sendUpdates": "all" }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Eliminar evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [520, 480],
      "onError": "continueRegularOutput",
      "notes": "Si el evento ya no existe, se responde igual: la tarea ya se borró en FerreObras."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ google_event_id: $json.id || $('Webhook vip-agenda').item.json.body.tarea.google_event_id || null, html_link: $json.htmlLink || '' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Responder a FerreObras",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [820, 300],
      "notes": "FerreObras guarda google_event_id y html_link (enlace \"En Google Calendar\")."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'Evento no reconocido: ' + $json.body.evento }) }}",
        "options": { "responseCode": 400 }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Evento no reconocido",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 660]
    }
  ],
  "connections": {
    "Webhook vip-agenda": { "main": [ [ { "node": "¿Qué pasó?", "type": "main", "index": 0 } ] ] },
    "¿Qué pasó?": { "main": [
      [ { "node": "Crear evento", "type": "main", "index": 0 } ],
      [ { "node": "Actualizar evento", "type": "main", "index": 0 } ],
      [ { "node": "Eliminar evento", "type": "main", "index": 0 } ],
      [ { "node": "Evento no reconocido", "type": "main", "index": 0 } ]
    ] },
    "Crear evento": { "main": [ [ { "node": "Responder a FerreObras", "type": "main", "index": 0 } ] ] },
    "Actualizar evento": { "main": [
      [ { "node": "Responder a FerreObras", "type": "main", "index": 0 } ],
      [ { "node": "Crear evento", "type": "main", "index": 0 } ]
    ] },
    "Eliminar evento": { "main": [ [ { "node": "Responder a FerreObras", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/Bogota" },
  "meta": { "instanceId": "ferreobras" }
}
