{
  "name": "VIP_Agenda",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vip-agenda",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook vip-agenda",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "vip-agenda",
      "notes": "Recibe de FerreObras { evento, tarea, ts }. evento: tarea_creada | tarea_actualizada | tarea_eliminada. La tarea ya trae titulo (\"1 - Tarea - 3232\"), descripcion, inicio, fin, todo_el_dia, color_id, correo_responsable y google_event_id."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.body.evento }}",
                    "rightValue": "tarea_creada",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "crear"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "c2",
                    "leftValue": "={{ $json.body.evento }}",
                    "rightValue": "tarea_actualizada",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "actualizar"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "c3",
                    "leftValue": "={{ $json.body.evento }}",
                    "rightValue": "tarea_eliminada",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "eliminar"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "¿Qué pasó?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary",
          "cachedResultName": "Calendario de la cuenta maestra"
        },
        "start": "={{ $('Webhook vip-agenda').item.json.body.tarea.inicio }}",
        "end": "={{ $('Webhook vip-agenda').item.json.body.tarea.fin }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "allday": "={{ $('Webhook vip-agenda').item.json.body.tarea.todo_el_dia ? 'yes' : 'no' }}",
          "attendees": "={{ $('Webhook vip-agenda').item.json.body.tarea.correo_responsable ? [$('Webhook vip-agenda').item.json.body.tarea.correo_responsable] : [] }}",
          "color": "={{ $('Webhook vip-agenda').item.json.body.tarea.color_id }}",
          "description": "={{ $('Webhook vip-agenda').item.json.body.tarea.descripcion }}",
          "guestsCanModify": true,
          "sendUpdates": "all",
          "summary": "={{ $('Webhook vip-agenda').item.json.body.tarea.titulo }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Crear evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        1000,
        120
      ],
      "notes": "Crea el evento en el calendario de la cuenta maestra e invita al correo de la línea responsable (lineas_whatsapp). Elige el calendario tras enlazar la credencial."
    },
    {
      "parameters": {
        "operation": "update",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary",
          "cachedResultName": "Calendario de la cuenta maestra"
        },
        "eventId": "={{ $json.body.tarea.google_event_id }}",
        "useDefaultReminders": true,
        "updateFields": {
          "allday": "={{ $json.body.tarea.todo_el_dia ? 'yes' : 'no' }}",
          "attendees": "={{ $json.body.tarea.correo_responsable ? [$json.body.tarea.correo_responsable] : [] }}",
          "color": "={{ $json.body.tarea.color_id }}",
          "description": "={{ $json.body.tarea.descripcion }}",
          "end": "={{ $json.body.tarea.fin }}",
          "sendUpdates": "all",
          "start": "={{ $json.body.tarea.inicio }}",
          "summary": "={{ $json.body.tarea.titulo }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Actualizar evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        520,
        300
      ],
      "onError": "continueErrorOutput",
      "notes": "Si Google responde que el evento ya no existe (lo borraron a mano), se vuelve a crear. Cualquier otro error se devuelve a FerreObras sin crear nada, para no duplicar."
    },
    {
      "parameters": {
        "operation": "delete",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary",
          "cachedResultName": "Calendario de la cuenta maestra"
        },
        "eventId": "={{ $('Webhook vip-agenda').item.json.body.tarea.google_event_id }}",
        "options": {
          "sendUpdates": "all"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Eliminar evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        520,
        480
      ],
      "onError": "continueRegularOutput",
      "notes": "Si el evento ya no existe, se responde igual: la tarea ya se borró en FerreObras."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ google_event_id: $json.id || $('Webhook vip-agenda').item.json.body.tarea.google_event_id || null, html_link: $json.htmlLink || '' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Responder a FerreObras",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1240,
        300
      ],
      "notes": "FerreObras guarda google_event_id y html_link (enlace \"En Google Calendar\")."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'Evento no reconocido: ' + $json.body.evento }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Evento no reconocido",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        660
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "nf1",
              "leftValue": "={{ /not ?found|404|410|deleted|no existe/i.test(JSON.stringify($json.error ?? $json)) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "¿El evento ya no existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        760,
        420
      ],
      "notes": "Solo si Google dice que el evento no existe se crea de nuevo."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'Google Calendar no aceptó el cambio: ' + ($json.error && $json.error.message ? $json.error.message : JSON.stringify($json.error ?? $json)).slice(0, 300) }) }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Error de calendario",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1000,
        520
      ],
      "notes": "FerreObras muestra 'Sin copia en el calendario' con el botón Reintentar; no se crea un evento duplicado."
    }
  ],
  "connections": {
